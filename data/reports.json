    {
      "id": "health",
      "name": "Storage Health & Capacity Outlook",
      "description": "Fleet utilization, array health, and growth — where capacity and performance risk is building.",
      "owner": "Kevin Key",
      "refreshed": "2026-10-06T00:00:23",
      "dataset": "arrays",
      "chartColumns": 3,
      "kpis": [
        {
          "label": "USED CAPACITY",
          "agg": "sum",
          "field": "usedTiB",
          "format": "tib0",
          "spark": {
            "source": "fleetDaily",
            "y": "usedTiB"
          },
          "delta": {
            "label": "vs 30 days ago"
          }
        },
        {
          "label": "TOTAL IOPS",
          "agg": "sum",
          "field": "iops",
          "format": "num",
          "spark": {
            "source": "fleetDaily",
            "y": "iops"
          },
          "delta": {
            "label": "vs 30 days ago",
            "goodWhen": "up"
          }
        },
        {
          "label": "AVG LATENCY",
          "agg": "avg",
          "field": "latencyMs",
          "format": "msu",
          "spark": {
            "source": "fleetDaily",
            "y": "latency"
          },
          "delta": {
            "label": "vs 30 days ago",
            "goodWhen": "down"
          }
        },
        {
          "label": "CRITICAL ARRAYS",
          "agg": "count",
          "where": {
            "status": "Critical"
          },
          "spark": {
            "source": "fleetDaily",
            "y": "critical"
          },
          "delta": {
            "label": "vs 30 days ago",
            "goodWhen": "down",
            "mode": "abs"
          }
        }
      ],
      "charts": [
        {
          "id": "util",
          "type": "gauge",
          "title": "Fleet capacity utilization",
          "subtitle": "Used of raw capacity",
          "num": {
            "agg": "sum",
            "field": "usedTiB"
          },
          "den": {
            "agg": "sum",
            "field": "rawTiB"
          },
          "warn": 75,
          "crit": 90,
          "unit": "TiB"
        },
        {
          "id": "byDc",
          "type": "pie",
          "donut": true,
          "title": "Used capacity by data center",
          "subtitle": "TiB",
          "groupBy": "dataCenter",
          "sum": "usedTiB",
          "format": "tib",
          "centerLabel": "TiB used"
        },
        {
          "id": "health",
          "type": "stacked",
          "title": "Array health by data center",
          "subtitle": "Array count",
          "groupBy": "dataCenter",
          "stackBy": "status",
          "order": [
            "OK",
            "Warning",
            "Critical"
          ],
          "colors": [
            "#90c44b",
            "#ffac00",
            "#ff4548"
          ]
        },
        {
          "id": "trend",
          "type": "line",
          "area": true,
          "span": 2,
          "vw": 940,
          "title": "Fleet used capacity",
          "subtitle": "Daily, last 30 days, TiB",
          "source": "fleetDaily",
          "x": "date",
          "xFormat": "monthDay",
          "xEvery": 5,
          "series": [
            {
              "key": "usedTiB",
              "name": "Used capacity",
              "format": "tib"
            }
          ],
          "ticks": [
            0,
            2000,
            4000,
            6000
          ],
          "height": 200
        },
        {
          "id": "tight",
          "type": "bullets",
          "title": "Most constrained arrays",
          "subtitle": "Used %, warning 75 · critical 90",
          "label": "name",
          "value": "usedPct",
          "limit": 6,
          "max": 100,
          "warn": 75,
          "crit": 90
        }
      ],
      "table": {
        "columns": [
          {
            "key": "name",
            "label": "Array",
            "w": 1.4
          },
          {
            "key": "dataCenter",
            "label": "Data center"
          },
          {
            "key": "model",
            "label": "Model"
          },
          {
            "key": "usedPct",
            "label": "Used",
            "format": "pct",
            "warn": 75,
            "crit": 90
          },
          {
            "key": "usedTiB",
            "label": "Used TiB",
            "format": "tib"
          },
          {
            "key": "iopsTrend",
            "label": "IOPS, 14 days",
            "format": "spark",
            "w": 1.2
          },
          {
            "key": "iops",
            "label": "IOPS",
            "format": "num"
          },
          {
            "key": "latencyMs",
            "label": "Latency (ms)",
            "format": "ms2",
            "warn": 5,
            "crit": 10
          },
          {
            "key": "daysToFull",
            "label": "Days to full",
            "format": "num",
            "warn": 90,
            "crit": 30,
            "lowIsBad": true
          },
          {
            "key": "status",
            "label": "Status",
            "format": "status",
            "w": 1.1
          }
        ]
      },
      "assistant": {
        "prompts": [
          {
            "id": "crit",
            "label": "Only show critical arrays",
            "match": [
              "critical"
            ],
            "action": {
              "type": "filter",
              "where": {
                "status": "Critical"
              },
              "label": "Status: Critical"
            },
            "reply": "Filtered to **critical** arrays. The cards, gauge, breakdowns and table now cover only those. The 30-day trend is fleet history, so it stays the same.",
            "summary": "Filtered to Critical arrays"
          },
          {
            "id": "latSpark",
            "label": "Add a latency trend column",
            "match": [
              "latency trend",
              "latency spark"
            ],
            "action": {
              "type": "addColumn",
              "after": "latencyMs",
              "column": {
                "key": "latencyTrend",
                "label": "Latency, 14 days",
                "format": "spark",
                "w": 1.2
              }
            },
            "reply": "Added a **Latency, 14 days** sparkline next to Latency. fas8200-dur is clearly climbing.",
            "summary": "Added Latency, 14 days column"
          },
          {
            "id": "wide",
            "label": "Make the capacity trend full width",
            "match": [
              "full width",
              "wider"
            ],
            "action": {
              "type": "resize",
              "id": "trend",
              "span": "full",
              "vw": 1420
            },
            "reply": "Made **Fleet used capacity** span the full width of the report.",
            "summary": "Capacity trend → full width"
          },
          {
            "id": "donutBar",
            "label": "Change the donut to a bar chart",
            "match": [
              "donut bar",
              "bar chart"
            ],
            "action": {
              "type": "replaceChart",
              "id": "byDc",
              "chart": {
                "id": "byDc",
                "type": "bar",
                "horizontal": true,
                "title": "Used capacity by data center",
                "subtitle": "TiB",
                "groupBy": "dataCenter",
                "sum": "usedTiB",
                "format": "tib",
                "height": 220
              }
            },
            "reply": "Switched **Used capacity by data center** to a bar chart, sorted largest to smallest.",
            "summary": "Capacity by data center → bar chart"
          },
          {
            "id": "line",
            "label": "Show the trend as a line, not an area",
            "match": [
              "line"
            ],
            "action": {
              "type": "replaceChart",
              "id": "trend",
              "chart": {
                "id": "trend",
                "type": "line",
                "span": 2,
                "vw": 940,
                "title": "Fleet used capacity",
                "subtitle": "Daily, last 30 days, TiB",
                "source": "fleetDaily",
                "x": "date",
                "xFormat": "monthDay",
                "xEvery": 5,
                "series": [
                  {
                    "key": "usedTiB",
                    "name": "Used capacity",
                    "format": "tib"
                  }
                ],
                "ticks": [
                  0,
                  2000,
                  4000,
                  6000
                ],
                "height": 200
              }
            },
            "reply": "Switched **Fleet used capacity** from an area chart to a line chart.",
            "summary": "Capacity trend → line chart"
          },
          {
            "id": "sortFull",
            "label": "Sort by days until full",
            "match": [
              "days",
              "full soon",
              "sort full"
            ],
            "action": {
              "type": "sort",
              "key": "daysToFull",
              "desc": false
            },
            "reply": "Sorted the table by **Days to full**, soonest first.",
            "summary": "Sorted by Days to full"
          }
        ]
      },
      "crossFilter": true
    }
  ]
}