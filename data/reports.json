{
  "reports": [
    {
      "id": "orphaned",
      "name": "Orphaned Volumes — Reclamation List",
      "description": "Volumes with no IO in 90+ days, with the capacity each one would return.",
      "owner": "Kevin Key",
      "refreshed": "2026-10-04T00:00:23",
      "dataset": "volumes",
      "chartColumns": 3,
      "kpis": [
        {
          "label": "CANDIDATE VOLUMES",
          "agg": "count"
        },
        {
          "label": "RECLAIMABLE CAPACITY",
          "agg": "sum",
          "field": "capacityTiB",
          "format": "tib0"
        },
        {
          "label": "DATA CENTERS",
          "agg": "distinct",
          "field": "dataCenter"
        },
        {
          "label": "HIGH CONFIDENCE",
          "agg": "count",
          "where": {
            "confidence": "High"
          }
        }
      ],
      "charts": [
        {
          "type": "pie",
          "title": "Reclaimable capacity by data center",
          "subtitle": "TiB",
          "groupBy": "dataCenter",
          "sum": "capacityTiB",
          "unit": "TiB",
          "id": "byDc"
        },
        {
          "type": "bar",
          "title": "Candidates by time since last IO",
          "subtitle": "Volume count",
          "field": "daysSinceIO",
          "buckets": [
            {
              "label": "90–120 days",
              "min": 90,
              "max": 120
            },
            {
              "label": "120–180 days",
              "min": 120,
              "max": 180
            },
            {
              "label": "180–365 days",
              "min": 180,
              "max": 365
            },
            {
              "label": "365+ days",
              "min": 365
            }
          ],
          "ticks": [
            0,
            200,
            400
          ],
          "format": "volumes",
          "id": "ioAge"
        },
        {
          "type": "line",
          "title": "Reclaimable capacity over time",
          "subtitle": "Weekly, TiB",
          "source": "orphanedCapacityWeekly",
          "x": "week",
          "xFormat": "monthDay",
          "series": [
            {
              "key": "tib",
              "name": "Reclaimable capacity"
            }
          ],
          "ticks": [
            0,
            50,
            100,
            150
          ],
          "format": "tib",
          "id": "overTime"
        }
      ],
      "table": {
        "columns": [
          {
            "key": "name",
            "label": "Volume",
            "w": 1.6
          },
          {
            "key": "array",
            "label": "Array",
            "w": 1.2
          },
          {
            "key": "dataCenter",
            "label": "Data center"
          },
          {
            "key": "capacityTiB",
            "label": "Capacity",
            "format": "cap"
          },
          {
            "key": "daysSinceIO",
            "label": "Last IO",
            "format": "days"
          },
          {
            "key": "businessUnit",
            "label": "Business unit"
          },
          {
            "key": "confidence",
            "label": "Confidence"
          }
        ]
      },
      "assistant": {
        "prompts": [
          {
            "id": "host",
            "label": "Add a column for host",
            "match": [
              "host"
            ],
            "action": {
              "type": "addColumn",
              "after": "array",
              "column": {
                "key": "host",
                "label": "Host"
              }
            },
            "reply": "Added a **Host** column next to Array, showing the host each volume was last mounted on.",
            "summary": "Added Host column"
          },
          {
            "id": "high",
            "label": "Only show high-confidence volumes",
            "match": [
              "high"
            ],
            "action": {
              "type": "filter",
              "where": {
                "confidence": "High"
              },
              "label": "Confidence: High"
            },
            "reply": "Filtered to **high-confidence** volumes: 612 of 847. The cards, the two breakdown charts and the table now count only those. The weekly trend is historical, so it stays the same.",
            "summary": "Filtered to High confidence"
          },
          {
            "id": "pieBar",
            "label": "Change the pie chart to a bar chart",
            "match": [
              "pie bar",
              "bar chart"
            ],
            "action": {
              "type": "replaceChart",
              "id": "byDc",
              "chart": {
                "id": "byDc",
                "type": "bar",
                "horizontal": true,
                "title": "Reclaimable capacity by data center",
                "subtitle": "TiB",
                "groupBy": "dataCenter",
                "sum": "capacityTiB",
                "format": "tib",
                "height": 220
              }
            },
            "reply": "Switched **Reclaimable capacity by data center** to a bar chart, sorted largest to smallest.",
            "summary": "Capacity by data center → bar chart"
          },
          {
            "id": "noArray",
            "label": "Remove the Array column",
            "match": [
              "array"
            ],
            "action": {
              "type": "removeColumn",
              "key": "array"
            },
            "reply": "Removed the **Array** column from the table.",
            "summary": "Removed Array column"
          },
          {
            "id": "sortCap",
            "label": "Sort by capacity, largest first",
            "match": [
              "sort capacity",
              "largest"
            ],
            "action": {
              "type": "sort",
              "key": "capacityTiB",
              "desc": true
            },
            "reply": "Sorted the table by **Capacity**, largest first.",
            "summary": "Sorted by Capacity, largest first"
          },
          {
            "id": "noTrend",
            "label": "Hide the capacity over time chart",
            "match": [
              "over time",
              "trend"
            ],
            "action": {
              "type": "removeChart",
              "id": "overTime"
            },
            "reply": "Removed **Reclaimable capacity over time**. The other two charts widen to fill the row.",
            "summary": "Removed capacity over time chart"
          }
        ]
      }
    },
    {
      "id": "app",
